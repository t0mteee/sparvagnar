# Kopiera till .env (gitignorerad) och fyll i.
#   cp .env.example .env

# Porten kartan nås på, http://localhost:8125. Upptagna på servern: 8002,
# 5175, 3100, 3000, 8123 och 8124.
PORT=8125

# Västtrafiks utvecklarportal: applikationens nyckel och hemlighet, med
# prenumeration på Planera Resa v4. Ger vagnarnas positioner.
VASTTRAFIK_KEY=
VASTTRAFIK_SECRET=

# Trafiklab: nyckel för GTFS Regional Static. Ger linjer, hållplatser,
# tidtabell och spårens dragning.
TRAFIKLAB_KEY=

# Cloudflare Tunnel, för att nå sidan utifrån (se README.md, Nå sidan utifrån).
# Token från tunneln i Cloudflare Zero Trust, delen efter --token.
TUNNEL_TOKEN=
